# Server Configuration
PORT=4000
NODE_ENV=development
# Required in production: generate a random value of at least 32 characters.
JWT_SECRET=
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=./data/akab.sqlite

# IPFS Decentralized Storage Configuration
# If local or remote Kubo node is running:
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY=https://ipfs.io/ipfs/
# Set to 'false' if external node is unavailable (will use local CID content-addressed store)
IPFS_FALLBACK_LOCAL=true

# GDPR / Retention Policy
GDPR_RETENTION_DAYS=30
GDPR_CLEANUP_INTERVAL_HOURS=24

# Initial Admin Credentials (seeded on first boot)
ADMIN_DEFAULT_EMAIL=admin@akab.local
ADMIN_DEFAULT_PASSWORD=
ADMIN_DEFAULT_NAME=Admin AKAB

# Moderation: distinct moderators required to publish, and login lockout policy
MODERATION_REQUIRED_APPROVALS=2
MODERATION_MAX_FAILED_LOGINS=5
MODERATION_LOCKOUT_MINUTES=15

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_SUBMISSIONS=20
RATE_LIMIT_MAX_REQUESTS=200
