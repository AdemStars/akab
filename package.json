{
  "name": "akab",
  "version": "1.0.0",
  "description": "AKAB - Plateforme décentralisée de signalement des violences policières",
  "author": "AKAB Contributors",
  "license": "AGPL-3.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "local": "bash scripts/local.sh up",
    "local:down": "bash scripts/local.sh down",
    "local:status": "bash scripts/local.sh status",
    "local:rebuild": "bash scripts/local.sh rebuild",
    "local:demo": "bash scripts/local.sh demo",
    "local:reset-demo": "bash scripts/local.sh reset-demo",
    "local:test": "bash scripts/local.sh test",
    "test": "npm run test --workspace=backend && npm run test --workspace=frontend",
    "test:backend": "npm run test --workspace=backend",
    "test:frontend": "npm run test --workspace=frontend",
    "lint": "npm run lint --workspace=backend && npm run lint --workspace=frontend"
  }
}
